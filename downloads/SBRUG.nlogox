      <choice type="string" value="uniformly random"></choice>
    </chooser>
    <monitor x="363" precision="5" y="57" height="60" fontSize="11" width="100" display="prob-exp">three-significant-digits prob-exp</monitor>
    <slider x="650" step="1" y="90" max="200" width="215" display="horizon" height="50" min="1" direction="Horizontal" default="98.0" variable="horizon"></slider>

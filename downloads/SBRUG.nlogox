Claims from 2 to <br> (horizon + 2)</div>]]></note>
    <monitor x="400" precision="0" y="200" height="57" fontSize="11" display="time" width="65" sizeVersion="0">ticks</monitor>
    <slider x="235" step="10" y="215" max="5000" display="final-time" height="42" min="10" direction="Horizontal" default="300.0" variable="final-time" width="160" sizeVersion="0"></slider>
    <plot x="5" autoPlotX="true" yMax="1.0" autoPlotY="true" yAxis="C/n" y="265" xMin="0.0" height="280" legend="true" xMax="10.0" yMin="0.0" width="460" xAxis="time" display="Cooperation C/n">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Sampling BR" color="-8703340" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen interval="1.0" mode="0" display="Exact BR" color="-14976969" legend="true">
        <setup></setup>
        <update></update>
      </pen>
    </plot>
    <monitor x="220" precision="3" y="550" height="60" fontSize="11" width="245" display="mean C/n Sampling BR, from mean-from">three-significant-digits mean-cooperation sbr-coop-history</monitor>
    <monitor x="220" precision="3" y="615" height="60" fontSize="11" width="245" display="mean C/n Exact BR, from mean-from">three-significant-digits mean-cooperation br-coop-history</monitor>
    <slider x="5" step="10" y="585" max="5000" width="205" display="mean-from" height="50" min="0" direction="Horizontal" default="100.0" variable="mean-from"></slider>

<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; GNU GENERAL PUBLIC LICENSE ;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; SBRUG: Sampling Best Response in Undercutting Games
;; SBRUG is a model designed to compare sampling best response
;; with best response to the exact population state in two undercutting games:
;; the traveler's dilemma and the finitely repeated prisoner's dilemma.
;; Both revision rules run at the same time, on two populations that share
;; the revising agents, the decisions to experiment and the experimental strategies.
;; Related paper: "How Sampling and Experimentation Sustain Cooperation in
;; Undercutting Games", by Luis R. Izquierdo and Segismundo S. Izquierdo.
;; Website, with an online version of the model: https://luis-r-izquierdo.github.io/sbrug/
;; DOI: https://doi.org/10.5281/zenodo.23734407
;;
;; Copyright (C) 2026 Luis R. Izquierdo & Segismundo S. Izquierdo
;;
;; This program is free software: you can redistribute it and/or modify
;; it under the terms of the GNU General Public License as published by
;; the Free Software Foundation, either version 3 of the License, or
;; (at your option) any later version.
;;
;; This program is distributed in the hope that it will be useful,
;; but WITHOUT ANY WARRANTY; without even the implied warranty of
;; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
;; GNU General Public License for more details.
;;
;; You should have received a copy of the GNU General Public License
;; along with this program.  If not, see <http://www.gnu.org/licenses/>.
;;
;; Contact information:
;; Luis R. Izquierdo
;;   University of Burgos, Spain.
;;   e-mail: lrizquierdo@ubu.es


;;;;;;;;;;;;;;;;;
;;; VARIABLES ;;;
;;;;;;;;;;;;;;;;;

globals [
  n-of-strategies     ;; horizon + 1 
                      ;; strategy i means stop at i 
                      ;; strategy (horizon + 1) never stops first
  strategy-numbers    ;; [1 2 ... n-of-strategies]

  ;; payoffs: strategy i earns A(i) against a later strategy,
  ;; B(i) against itself, and F(j) against an earlier strategy j
  A-payoffs           ;; item (i - 1) is A(i)
  B-payoffs           ;; item (i - 1) is B(i)
  F-payoffs           ;; item (i - 1) is F(i)
  premium-ratio       ;; premium bound divided by waiting gain. Each period of delay raises
                      ;; A(i), the payoff of stopping first at i, by at least the waiting gain.
                      ;; Against strategy i, matching i or stopping at i - 1 earns at most
                      ;; the premium bound more than any later strategy

  sbr-counts           ;; item (i - 1) is the number of agents using strategy i under sampling
  br-counts            ;; item (i - 1) is the number of agents using strategy i under exact information
  br-reply             ;; best reply to the exact population state
  br-reply-up-to-date? ;; false if br-counts have changed since br-reply was computed

  n-of-players          ;; this number never changes during a simulation
  experiments-this-tick ;; strategies above 1 chosen by experimenting agents in the current tick
                        ;; (only for displaying purposes)

  sbr-coop-history    ;; item (t - 1) is C/n under sampling at tick t
  br-coop-history     ;; item (t - 1) is C/n under exact information at tick t
  run-length          ;; final-time at setup; this number never changes during a simulation

  sbr-row-0           ;; row of the view that shows strategy 1 under sampling
  br-row-0            ;; row of the view that shows strategy 1 under exact information
]

breed [players player]

players-own [
  sbr-strategy  ;; strategy under sampling best response, an integer between 1 and n-of-strategies
  br-strategy   ;; strategy under best response to the exact population state
]


;;;;;;;;;;;;;
;;; SETUP ;;;
;;;;;;;;;;;;;

to startup

  clear-all
  ;; NetLogo Web starts every session with the same random seed
  if netlogo-web? [ random-seed new-seed ]

  setup-globals
  
  if not valid-PD-payoffs? [
    user-message "The prisoner's dilemma requires T > R > P > S."
    stop
  ]
  
  setup-world   ;; before setup-agents, since resize-world kills all turtles
  setup-payoffs
  setup-agents

  reset-ticks
  setup-graphs
  update-graphs

end


to setup-globals

  set n-of-strategies horizon + 1
  set strategy-numbers (range 1 (n-of-strategies + 1))
  set n-of-players n-of-agents

  set experiments-this-tick []
  set run-length final-time

  ;; keep the mean monitors valid even if parameter validation stops setup
  set sbr-coop-history []
  set br-coop-history []

end


to-report valid-PD-payoffs?
  report game != "repeated prisoner's dilemma -->>" or
         (payoff-T > payoff-R and payoff-R > payoff-P and payoff-P > payoff-S)
end


to setup-world

  ;; for each revision rule, one row per strategy. The view is at most 710 x 480
  ;; pixels, and patches are whole pixels so that all marks have the same size.
  ;; Patches are as large as possible while the view keeps one column per tick,
  ;; or at least 300 columns in runs longer than 300 ticks
  let n-of-rows 2 * n-of-strategies + 5
  let pixels max (list 1 floor min (list (480 / n-of-rows) (710 / min (list run-length 300))))
  let n-of-columns min (list run-length floor (710 / pixels))
  resize-world 0 (n-of-columns - 1) 0 (n-of-rows - 1)
  set-patch-size pixels

  set br-row-0 0
  set sbr-row-0 n-of-strategies + 5

  ask patches [ set pcolor white ]
  ask patches with [pycor >= n-of-strategies and pycor < sbr-row-0] [ set pcolor 8 ]

end


to setup-payoffs

  ifelse game = "<<-- traveler's dilemma"
  [ ;; strategy i is the claim i + 1. Both travelers are paid the lower claim,
    ;; and the reward is added to the lower claimant's payment and subtracted
    ;; from the higher claimant's. At a tie both receive their claim.
    set A-payoffs map [ i -> i + 1 + reward ] strategy-numbers
    set B-payoffs map [ i -> i + 1 ] strategy-numbers
    set F-payoffs map [ j -> j + 1 - reward ] strategy-numbers

    ;; waiting gain 1 and premium bound (2 * reward - 1)
    set premium-ratio (2 * reward - 1)
  ]
  [ ;; repeated prisoner's dilemma with horizon rounds. Strategy i cooperates until
    ;; round i - 1 and defects from round i on, or from the round after the
    ;; opponent's first defection, if earlier. Strategy horizon + 1 never defects first.
    set A-payoffs map [ i -> (i - 1) * payoff-R + payoff-T + (horizon - i) * payoff-P ] strategy-numbers
    set B-payoffs map [ i -> (i - 1) * payoff-R + (horizon - i + 1) * payoff-P ] strategy-numbers
    set F-payoffs map [ j -> (j - 1) * payoff-R + payoff-S + (horizon - j) * payoff-P ] strategy-numbers

    ;; waiting gain (R - P) and premium bound (T - R + P - S)
    set premium-ratio (payoff-T - payoff-R + payoff-P - payoff-S) / (payoff-R - payoff-P)
  ]

end


to setup-agents

  create-players n-of-players [
    set sbr-strategy initial-strategy
    set br-strategy sbr-strategy   ;; both populations start from the same state
    set hidden? true
  ]

  set sbr-counts map [ i -> count players with [sbr-strategy = i] ] strategy-numbers
  set br-counts sbr-counts
  set br-reply-up-to-date? false

end


to-report initial-strategy
  report (ifelse-value
    initial-state = "everyone at strategy 1" [ 1 ]
    initial-state = "everyone at the last strategy" [ n-of-strategies ]
    [ one-of strategy-numbers ])  ;; "uniformly random"
end


;;;;;;;;;;;;
;;;  GO  ;;;
;;;;;;;;;;;;

;; Each agent revises at the times of its own rate-one Poisson clock. Then each
;; revision in the population is made by an agent chosen at random, and the
;; expected time between two revisions is 1 / n-of-players. We follow this
;; sequence of revisions: each tick consists of n-of-players revisions, which
;; is one unit of revision time.

to go
  if ticks >= run-length [ stop ]
  set experiments-this-tick []
  repeat n-of-players [ update-strategy ]
  tick
  record-cooperation
  update-graphs
end


;;;;;;;;;;;;;;;;;;;;;;;
;;; UPDATE-STRATEGY ;;;
;;;;;;;;;;;;;;;;;;;;;;;

;; Both populations share the revising agent, the decision to experiment and
;; the experimental strategy.

to update-strategy
  let reviser random-player

  ifelse random-float 1 < prob-exp

  [ ;; experiment: choose a strategy at random
    let s one-of strategy-numbers
    if s > 1 [ set experiments-this-tick lput s experiments-this-tick ]
    ask reviser [
      set-sbr-strategy s
      set-br-strategy s
    ]
  ]

  [ ;; best respond
    ask reviser [
      set-sbr-strategy best-reply-to-sample
      set-br-strategy best-reply-to-population
    ]
  ]
end


to-report random-player
  ;; players have who numbers 0 to n-of-players - 1 (clear-all restarts the who
  ;; numbers), so we pick one by its who number. This is much faster than
  ;; one-of players, whose time grows with the number of players.
  report player random n-of-players
end


to set-sbr-strategy [s] ;; player procedure
  if s != sbr-strategy [
    set sbr-counts replace-item (sbr-strategy - 1) sbr-counts (item (sbr-strategy - 1) sbr-counts - 1)
    set sbr-counts replace-item (s - 1) sbr-counts (item (s - 1) sbr-counts + 1)
    set sbr-strategy s
  ]
end


to set-br-strategy [s] ;; player procedure
  if s != br-strategy [
    set br-counts replace-item (br-strategy - 1) br-counts (item (br-strategy - 1) br-counts - 1)
    set br-counts replace-item (s - 1) br-counts (item (s - 1) br-counts + 1)
    set br-strategy s
    set br-reply-up-to-date? false
  ]
end


;; The slider sets the probability of experimentation on a logarithmic scale.

to-report prob-exp
  report (10 ^ log10-prob-exp)
end


;;;;;;;;;;;;;;;;;;;
;;; BEST REPLIES ;;;
;;;;;;;;;;;;;;;;;;;

to-report best-reply-to-sample
  ;; observe sample-size agents, drawn at random with replacement
  let sample n-values sample-size [ [sbr-strategy] of random-player ]
  
  ;; every best reply lies between m - reply-width and m - 1, or is 1, where m is
  ;; the latest strategy in the sample (see reply-width)
  let m max sample
  let candidates (range (max list 1 (m - reply-width)) (max list 2 m))

  ;; total payoff of each candidate against the sample; ties select the smallest strategy
  let payoffs map [ i -> sum map [ j -> payoff i j ] sample ] candidates
  report item (position (max payoffs) payoffs) candidates
end


to-report reply-width
  ;; Let m be the latest strategy in the sample. Every best reply is 1 or lies between
  ;; m - reply-width and m - 1. No later strategy earns more than m - 1. Compared with
  ;; an earlier strategy j, m - 1 earns at least waiting gain * (m - 1 - j) more against
  ;; an observation of m, and at most the premium bound less against each other
  ;; observation. We compute it here, rather than in setup, so that sample-size can
  ;; be changed during a run.
  ;; The term 1e-9 guards against rounding errors when (sample-size - 1) times
  ;; the premium ratio is an integer.
  report floor ((sample-size - 1) * premium-ratio + 1e-9) + 1
end


to-report best-reply-to-population
  ;; the population state changes only at some revisions, so we compute
  ;; its best reply again only when it has changed
  if not br-reply-up-to-date? [
    let payoffs payoffs-against br-counts
    set br-reply 1 + position (max payoffs) payoffs  
      ;; ties select the smallest strategy (position reports the first position of item in list)
    set br-reply-up-to-date? true
  ]
  report br-reply
end


;;;;;;;;;;;;;;;
;;; PAYOFFS ;;;
;;;;;;;;;;;;;;;

to-report payoff [i j]  ;; payoff of strategy i against strategy j
  report (ifelse-value
    (i < j) [ item (i - 1) A-payoffs ]
    (i = j) [ item (i - 1) B-payoffs ]
            [ item (j - 1) F-payoffs ])
end


to-report payoffs-against [counts]
  ;; total payoff of each strategy i against a population with these strategy counts:
  ;; A(i) times the number of agents using later strategies, plus B(i) times the
  ;; number using i, plus F(j) times the number using j, summed over j < i
  let n-later sum counts
  let F-earlier 0
  let payoffs []
  (foreach counts A-payoffs B-payoffs F-payoffs [
    [n-at-i A B F] ->
    set n-later n-later - n-at-i
    set payoffs lput (A * n-later + B * n-at-i + F-earlier) payoffs
    set F-earlier F-earlier + F * n-at-i
  ])
  report payoffs
end


;;;;;;;;;;;;;;;;;;;
;;; COOPERATION ;;;
;;;;;;;;;;;;;;;;;;;

to-report cooperation [counts]
  ;; C / n, where C is the expected number of periods before the earlier
  ;; stop in a random match: the sum over j > 1 of Q(j) ^ 2, with Q(j) the
  ;; share of agents using strategy j or later
  let share-j-or-later 0
  let C 0
  foreach reverse but-first counts [ n-at-j ->
    set share-j-or-later share-j-or-later + n-at-j / n-of-players
    set C C + share-j-or-later ^ 2
  ]
  report C / (n-of-strategies - 1)  ;; the horizon at setup
end


to record-cooperation
  set sbr-coop-history lput (cooperation sbr-counts) sbr-coop-history
  set br-coop-history  lput (cooperation br-counts)  br-coop-history
end


to-report mean-cooperation [history]
  ;; average of C/n over ticks t >= mean-from. We keep the whole history,
  ;; so mean-from can be changed at any time during a run
  let first-index max (list 0 (mean-from - 1))
  report ifelse-value (first-index < length history)
    [ mean sublist history first-index (length history) ]
    [ "-" ]
end


;;;;;;;;;;;;;;;;
;;; MONITORS ;;;
;;;;;;;;;;;;;;;;

to-report three-significant-digits [x]
  ;; x with three significant digits, as text. NetLogo Web rounds monitors to a
  ;; fixed number of decimal places, so it would show small values as 0
  if not is-number? x or x = 0 [ report (word x) ]
  report (word precision x (2 - floor log (abs x) 10))
end


;;;;;;;;;;;;;;
;;; GRAPHS ;;;
;;;;;;;;;;;;;;

to setup-graphs
  set-current-plot "Cooperation C/n"
  set-plot-x-range 0 run-length
end


to update-graphs

  set-current-plot "Cooperation C/n"
  set-current-plot-pen "Sampling BR"
  plotxy ticks cooperation sbr-counts
  set-current-plot-pen "Exact BR"
  plotxy ticks cooperation br-counts

  ;; tick t goes to column floor((t - 1) * world-width / run-length). When a column
  ;; covers several ticks, we draw only the last one
  if ticks > 0 and floor (ticks * world-width / run-length) > floor ((ticks - 1) * world-width / run-length) [
    let x floor ((ticks - 1) * world-width / run-length)
    draw-column x sbr-counts sbr-row-0
    draw-column x br-counts br-row-0
  ]

end


to draw-column [x counts row-0]
  ;; share of each strategy, from dark blue (share 1) to light blue (share 1 / n-of-players)
  ;; on a logarithmic scale; white denotes zero. Orange cells mark experiments with
  ;; strategies above 1 in this tick.
  (foreach strategy-numbers counts [ [s n-at-s] ->
    let share n-at-s / n-of-players
    ask patch x (row-0 + s - 1) [
      set pcolor ifelse-value (share = 0)
        [ white ]
        [ 101 + 7 * (ln share) / (ln (1 / n-of-players)) ]
    ]
  ])
  foreach experiments-this-tick [ s ->
    ask patch x (row-0 + s - 1) [ set pcolor orange ]
  ]
end
]]></code>
